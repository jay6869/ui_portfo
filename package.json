{
  "name": "janith-godage-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && npm run build:only",
    "build:only": "node scripts/github.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && NODE_ENV=production node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs --port 4173",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p cypress/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "assets": "node scripts/og.mjs && node scripts/cv.mjs",
    "shoot": "node scripts/shoot.mjs",
    "audit:a11y": "node scripts/axe.mjs",
    "analyze": "ANALYZE=1 vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test preview http://localhost:4173 cy:run"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "immer": "^11.1.18",
    "leaflet": "^1.9.4",
    "locomotive-scroll": "^5.0.1",
    "lodash-es": "^4.18.1",
    "p5": "^2.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sortablejs": "^1.15.7",
    "swiper": "^14.2.0",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/react-vite": "^10.6.0",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.20",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sortablejs": "^1.15.8",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "fontaine": "^1.0.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "satori": "^0.33.5",
    "start-server-and-test": "^2.1.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
